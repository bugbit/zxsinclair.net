@using System.Diagnostics
@implements IAsyncDisposable

@inject IJSRuntime JS

<canvas @ref="emulatorCanvas" width="320" height="240"></canvas>
<button @onclick="Test1Async">Test1</button>
<button data-testid="test2" @onclick="Test2Async">Test2</button>
<button data-testid="test-put-image" @onclick="TestPutImageAsync">TestPutImage</button>

@code {
    private ElementReference emulatorCanvas;
    private IJSObjectReference? module;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Emulator.razor.js");

            await module.InvokeVoidAsync("initCanvas", emulatorCanvas, 320, 240, false);
        }
    }

    private async Task Test1Async()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("Test1");
        }
    }

    private async Task Test2Async()
    {
        if (module is not null)
        {
            long start = Stopwatch.GetTimestamp();
            byte color = (byte)Random.Shared.Next(0, 255);
            byte[] data = new byte[320 * 240 * 4];

            for (int i = 0; i < data.Length; i += 4)
            {
                data[i] = color;     // Rojo; verde y azul quedan en 0.
                data[i + 3] = 255; // Alfa opaco.
            }

            await module.InvokeVoidAsync("putImagen2D", data);
            double elapsed = Stopwatch.GetElapsedTime(start).TotalMilliseconds;
            await module.InvokeVoidAsync("reportTiming", "Test2", elapsed);
        }
    }

    private async Task TestPutImageAsync()
    {
        if (module is not null)
        {
            long start = Stopwatch.GetTimestamp();
            await module.InvokeVoidAsync("TestPutImage");
            double elapsed = Stopwatch.GetElapsedTime(start).TotalMilliseconds;
            await module.InvokeVoidAsync("reportTiming", "TestPutImage", elapsed);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
